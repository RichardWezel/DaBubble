rules_version = '2';

// ---------------------------------------------------------------------------
// BASELINE - this is what is live on dabubble-1fb72, copied from the Firebase
// console on 2026-09-27. It is unrestricted on purpose: guestLogin() does not
// authenticate (it only writes a user document id into sessionStorage), so
// request.auth is null for guests and access cannot be tied to an identity.
//
// The practical consequence: anyone who reads the Firebase config out of the
// published bundle can write, overwrite or delete any document without ever
// opening the app.
//
// Stage 5 of the restructuring replaces this, once posts live in
// subcollections and documents carry an isSeed flag. Rules can then enforce
// document shape even without authentication:
//   - isSeed documents are not deletable and their name/owner is immutable
//   - post text length is capped
//   - non-seed posts must carry an expiresAt timestamp (for the TTL policy)
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
