rules_version = '2';

// ---------------------------------------------------------------------------
// PLACEHOLDER - DO NOT DEPLOY BEFORE READING THIS
//
// Until now this project had no firestore.rules in the repository, which means
// the rules that are actually live exist ONLY in the Firebase console.
// Deploying this file would overwrite them.
//
// Before the first `firebase deploy --only firestore:rules`:
//   1. Open console.firebase.google.com -> dabubble-1fb72 -> Firestore -> Rules
//   2. Copy what is there into this file
//   3. Commit that as the baseline, THEN start changing it
//
// The rules below only mirror what the app needs today so the emulator can
// run: full access without authentication, because guestLogin() does not
// authenticate (it only writes a user document id into sessionStorage).
// They are deliberately permissive and get replaced in stage 5, once posts
// live in subcollections and documents carry an isSeed flag.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
